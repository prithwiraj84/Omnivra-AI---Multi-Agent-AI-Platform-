# ===========================================================================
# Omnivra AI Company OS - Backend environment template
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# ===========================================================================

# --- App / runtime ---
APP_NAME="Omnivra AI Company OS"
APP_ENV=development                 # development | staging | production
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                      # true -> structured JSON logs (prod)

# CORS: comma-separated origins the Vite frontend is served from.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Absolute or relative path to the AI artifact sandbox. Agents may ONLY write here.
WORKSPACE_ROOT=../workspace

# --- LLM / Media providers ---
# TIP: every *_API_KEY below accepts a POOL of keys — comma-separated, e.g.
#   GROQ_API_KEY=key_one,key_two,key_three
# The provider rotates across them on rate limits (429), so several free-tier keys behave like
# one larger quota with automatic failover. Additionally, a TEXT agent whose provider is fully
# exhausted automatically falls back to another configured provider (Groq <-> Google).

# Google AI Studio (Gemini) - CEO/Manager, Architect, UI/UX, API, QA, SecOps, Social, Docs
GOOGLE_AI_STUDIO_API_KEY=

# OpenRouter (OpenAI-compatible) - Architect, DB/FE/BE/API Eng, SecOps, Social, Docs, Recovery, System-Ops.
# The free tier shares ~50 requests/day PER ACCOUNT across all :free models, so POOL several keys here
# (comma-separated) for a full multi-agent run. If OpenRouter is still exhausted, these agents auto-fall
# back to Groq then Gemini, so a run never stalls.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://omnivra.local     # sent as HTTP-Referer (OpenRouter attribution)
OPENROUTER_APP_NAME=Omnivra AI Company OS      # sent as X-Title

# Groq (OpenAI-compatible + Whisper/Orpheus) - QA, SEO, Reel, STT, TTS
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Text-to-Speech (reel voiceover) via Groq's /audio/speech.
# The backend AUTO-FALLS BACK: if the configured model is rejected (retired, no access, or terms
# not accepted) it retries the next known model+voice pair, so a reel gets a voiceover instead of
# rendering mute. Set these only to pin a specific voice.
#   playai-tts                     voices: Fritz-PlayAI, Arista-PlayAI, Atlas-PlayAI, …
#   canopylabs/orpheus-v1-english  voices: autumn, diana, hannah, austin, daniel, troy
# A VOICE ONLY WORKS WITH ITS OWN MODEL — always change both together.
# NOTE: these are ENGLISH-ONLY models. Hindi content never routes here (it would be "read" as
# mangled phonetics rather than failing) — it uses Gemini TTS (free) or ElevenLabs.
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=Fritz-PlayAI
GROQ_TTS_FORMAT=wav
# Some speech models need a one-time terms acceptance on your account:
# https://console.groq.com/playground  (open the model, accept, then retry)

# ElevenLabs — OPTIONAL high-fidelity TTS. When set it is used INSTEAD of the Groq voices for
# reel narration (Groq stays the automatic fallback). This is the setting that makes narration
# sound like a real person. Also configurable per-user in Integrations -> API keys.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                # optional; unset -> the first FREE-USABLE voice on the account.
                                    # Voice Library voices 402 on the free plan, so leaving this
                                    # blank is usually safer than pinning one.
ELEVENLABS_VOICE_ID_HI=             # optional; a separate narrator for Hindi content
ELEVENLABS_MODEL=eleven_multilingual_v2   # multilingual: needed for Hindi, fine for English

# Gemini TTS — the FREE multilingual voice. No extra key: it reuses GOOGLE_AI_STUDIO_API_KEY
# above. This is what narrates Hindi when ElevenLabs isn't configured, and it sits ahead of the
# Groq voices for English too. Leave the model blank to auto-pick whichever preview model this
# account can reach. Voices: Kore, Charon, Puck, Zephyr, Aoede, Leda, Orus, Fenrir, ...
GOOGLE_TTS_MODEL=                   # blank -> gemini-3.1-flash-tts-preview, then 2.5-flash
GOOGLE_TTS_VOICE=Kore
GOOGLE_TTS_VOICE_HI=                # optional; a separate narrator for Hindi

# Hugging Face - Image Generation via the hf-inference router.
# NOTE: hf-inference RETIRES models without warning — FLUX.1-schnell now returns 410
# 'deprecated'. The backend tries the configured model then known-good fallbacks, then
# Gemini image (on the Google AI key above), then a stub.
HUGGINGFACE_API_KEY=
HUGGINGFACE_INFERENCE_ENDPOINT=https://router.huggingface.co/hf-inference
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
GOOGLE_IMAGE_MODEL=                 # blank -> try gemini-3.1-flash-image, then 2.5

# --- Social publishing (all OPTIONAL) ---
# Also configurable IN THE APP: Integrations -> Publishing & Social (a value saved there OVERRIDES
# the matching var here). With credentials set, YouTube/LinkedIn/Facebook/Instagram/X publish FOR
# REAL (guarded + stub-safe: unset -> drafts + approval still work offline and publishing is
# recorded as a stub). See docs/SOCIAL_PUBLISHING.md + docs/PROVIDER_KEYS.md.
PEXELS_API_KEY=                     # reel B-roll (Video API) AND the stock-photo fallback
                                    # for post images when every generator is down

# YouTube (reel upload, OAuth2; see docs to obtain a refresh token)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# LinkedIn (post) — OAuth2 access token with the openid + profile + w_member_social scopes
LINKEDIN_ACCESS_TOKEN=

# Facebook Page (post) — Page access token + the numeric Page id
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=

# Instagram (reel) — Business/Creator account. Publishing needs Supabase Storage configured below
# (Instagram fetches the reel from a temporary public URL).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=                  # IG Business account id

# X / Twitter (post) — posting needs OAuth 1.0a USER-CONTEXT keys (the bearer token is read-only).
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=               # read-only; kept for parity (NOT used for posting)

# --- Supabase Cloud (Postgres + pgvector + Storage + Realtime) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=                  # browser-safe; used by frontend, mirrored here for parity
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY. Never expose to the frontend.
SUPABASE_DB_PASSWORD=               # for direct asyncpg / langgraph postgres checkpointer (Phase 3)
SUPABASE_STORAGE_BUCKET=omnivra-artifacts   # bucket used to host Instagram reels + artifacts
# Direct Postgres DSN (for langgraph-checkpoint-postgres in Phase 3)
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# --- PER-USER PRIVATE WORKSPACES ---
# Turn this on to give every signed-in user their OWN private set of projects. Unset/false =
# single-admin open mode. Requires the frontend to have VITE_SUPABASE_URL/ANON_KEY set too.
# See docs/PER_USER_WORKSPACES.md.
PER_USER_WORKSPACES=false
# How your project signs user tokens decides what else you need — check
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
#   * Returns a key (alg ES256/RS256) -> MODERN project. Nothing more to set; the backend verifies
#     against that JWKS. SUPABASE_URL above must be correct. Leave SUPABASE_JWT_SECRET empty.
#   * Returns no keys -> LEGACY project (HS256). Paste Settings -> API -> JWT Secret below.
# (Setting SUPABASE_JWT_SECRET also switches per-user mode on, for backwards compatibility.)
SUPABASE_JWT_SECRET=

# --- Redis / Upstash (queue + ephemeral run state) ---
REDIS_URL=redis://localhost:6379/0            # or rediss://default:[TOKEN]@[HOST].upstash.io:6379

# --- Orchestration safety ---
MAX_RECURSION=3                     # kill switch: recursion_count > MAX_RECURSION -> FAILED
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=2              # tenacity attempts on 429 / timeout / transient (kept low: the
                                    # key pool already rotates within one attempt, then fails over)

# --- Security ---
API_SECRET_KEY=change-me-in-prod    # signs internal tokens / approval resume tokens
# A PUBLIC deployment (e.g. a Hugging Face Space) has no network gate — TURN AUTH ON so strangers
# can't drive your agents and burn your provider quota. Then log in with the admin creds below.
AUTH_ENABLED=false                  # set true in any public deployment
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-prod
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=false            # set true in public deployments
RATE_LIMIT_PER_MINUTE=240

# --- Deployment / performance ---
# CORS: in prod set this to your Vercel URL, e.g. https://omnivra.vercel.app
# The universal app-runner spawns venv/npm subprocesses + binds local ports. On a shared host
# (HF Space) the launched app's localhost port isn't reachable AND running generated code is a
# security/AUP risk -> DISABLE it there (Download-as-ZIP + run locally still works).
APP_RUNNER_ENABLED=true             # set false on a shared/public host
DASHBOARD_CACHE_TTL=2.0             # seconds; many polling clients share one rebuild. 0 = off
GZIP_MIN_SIZE=512                   # gzip responses larger than this many bytes
